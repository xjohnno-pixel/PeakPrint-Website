{%- comment -%}
  Cart page — Peak Framed.
  Brand-styled cart with line items, the customer's adventure details
  as line item properties, and a check-out button. Discount codes
  are entered on the standard Shopify checkout page, not here.
{%- endcomment -%}

<section class="cart-section">
  <div class="cart-inner">

    {%- if cart.item_count == 0 -%}
      <div class="cart-empty">
        <p class="label-line">Your Cart</p>
        <h1 class="cart-headline">Your cart is empty</h1>
        <p class="cart-empty-body">Ready to turn your next adventure into a framed map? Head back to the home page to get started.</p>
        <a href="{{ routes.root_url }}" class="cta-btn">
          Continue shopping
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    {%- else -%}

      <div class="cart-header">
        <p class="label-line">Your Order</p>
        <h1 class="cart-headline">{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %} ready for checkout</h1>
      </div>

      <form action="{{ routes.cart_url }}" method="post" id="cartForm" class="cart-form" novalidate>

        <ul class="cart-items">
          {%- for item in cart.items -%}
            <li class="cart-item" data-cart-line="{{ forloop.index }}">

              <div class="cart-item-image">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 240 }}"
                       alt="{{ item.title | escape }}"
                       width="120" height="120"
                       loading="lazy">
                {%- endif -%}
              </div>

              <div class="cart-item-body">
                <div class="cart-item-head">
                  <div>
                    <h3 class="cart-item-title">
                      <a href="{{ item.url }}">{{ item.product.title }}</a>
                    </h3>
                    {%- if item.variant.title and item.variant.title != 'Default Title' -%}
                      <p class="cart-item-variant">{{ item.variant.title }}</p>
                    {%- endif -%}
                  </div>
                  <div class="cart-item-price-block">
                    <span class="cart-item-price">{{ item.final_line_price | money }}</span>
                    {%- if item.quantity > 1 -%}
                      <span class="cart-item-qty">Qty {{ item.quantity }}</span>
                    {%- endif -%}
                  </div>
                </div>

                {%- assign printable_props = false -%}
                {%- for prop in item.properties -%}
                  {%- assign key_first_char = prop.first | slice: 0, 1 -%}
                  {%- if prop.last != blank and key_first_char != '_' -%}
                    {%- assign printable_props = true -%}
                  {%- endif -%}
                {%- endfor -%}

                {%- if printable_props -%}
                  <dl class="cart-item-props">
                    {%- for prop in item.properties -%}
                      {%- assign key_first_char = prop.first | slice: 0, 1 -%}
                      {%- if prop.last != blank and key_first_char != '_' -%}
                        <div class="cart-item-prop">
                          <dt>{{ prop.first }}</dt>
                          <dd>
                            {%- if prop.last contains 'cloudinary.com' or prop.last contains 'res.cloudinary' -%}
                              <a href="{{ prop.last }}" target="_blank" rel="noopener noreferrer">View uploaded file ↗</a>
                            {%- elsif prop.last contains 'http://' or prop.last contains 'https://' -%}
                              <a href="{{ prop.last }}" target="_blank" rel="noopener noreferrer">{{ prop.last | truncate: 60 }}</a>
                            {%- else -%}
                              {{ prop.last }}
                            {%- endif -%}
                          </dd>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </dl>
                {%- endif -%}

                <div class="cart-item-actions">
                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="cart-item-remove">Remove</a>
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        <div class="cart-summary">
          <div class="cart-row">
            <span>Subtotal</span>
            <span>{{ cart.items_subtotal_price | money }}</span>
          </div>

          {%- if cart.cart_level_discount_applications.size > 0 -%}
            {%- for discount in cart.cart_level_discount_applications -%}
              <div class="cart-row cart-row--discount">
                <span>{{ discount.title }}</span>
                <span>−{{ discount.total_allocated_amount | money }}</span>
              </div>
            {%- endfor -%}
          {%- endif -%}

          <div class="cart-row cart-row--total">
            <span>Total</span>
            <span>{{ cart.total_price | money }} {{ cart.currency.iso_code }}</span>
          </div>

          <p class="cart-note">Delivery is included in the price. Discount codes can be applied at checkout. Production typically 1–3 business days; Australia Post delivery 3–7 business days after dispatch.</p>

          <button type="submit" name="checkout" class="order-btn">
            Check out — {{ cart.total_price | money }}
          </button>

          <a href="{{ routes.root_url }}" class="cart-continue">← Continue shopping</a>
        </div>
      </form>

    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
