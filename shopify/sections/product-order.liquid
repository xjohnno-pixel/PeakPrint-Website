{%- comment -%}
  Peak Framed product order section — full port of #get-started from
  ../index.html lines 1427–1695, rewired to Shopify product variants
  and the Shopify cart API instead of FormSubmit.

  Variants on the Adventure Map product are expected to be:
    option1 = Frame Colour (Black / White)
    option2 = Tile Colour  (Black / White)
  Variant titles render as "Black / Black", "Black / White", etc.

  Add-ons (Wall Mount / Stand / Both) are line item properties by
  default. If the merchant has created an "Optional Add-Ons" product
  with three variants and pasted their IDs into this section's
  settings, JS will additionally push a 2nd line item to the cart
  to charge for the add-on. Until then, the add-on selection is
  captured as a property only and the price button stays at base.

  All copy and the product handle are editable in the theme customiser.
{%- endcomment -%}

{%- liquid
  assign product = all_products[section.settings.product_handle]
  assign base_price_int = 169
  if product and product.variants.first.price
    assign base_price_int = product.variants.first.price | divided_by: 100
  endif
-%}

<section id="get-started" class="get-started-section">
  <div class="get-started-inner">
    <div class="fade-up section-header">
      {%- if section.settings.label != blank -%}
        <p class="label-line section-eyebrow">{{ section.settings.label }}</p>
      {%- endif -%}
      {%- if section.settings.headline != blank -%}
        <h2 class="section-headline">{{ section.settings.headline }}</h2>
      {%- endif -%}
    </div>

    {%- if product == blank -%}
      <div class="product-missing-warning" style="padding:2rem; border:1px dashed var(--color-accent); border-radius:6px; color:var(--color-text-secondary);">
        <strong style="color:var(--color-accent);">Configure this section:</strong>
        Open the theme customiser and set the <em>Product handle</em> for the
        Adventure Map product. Current value:
        <code>{{ section.settings.product_handle | default: '(empty)' }}</code>
      </div>
    {%- else -%}

    <div class="product-section fade-up">
      <!-- Left: Product image (4 frame × tile combinations) -->
      <div class="product-image-wrap">
        {%- assign default_combo = 'black-black' -%}
        {%- for v in product.variants -%}
          {%- assign frame = v.option1 | downcase -%}
          {%- assign tile  = v.option2 | downcase -%}
          {%- assign combo = frame | append: '-' | append: tile -%}
          {%- assign img = v.featured_image | default: product.featured_image -%}
          {%- if img != blank -%}
            <img
              src="{{ img | image_url: width: 1200 }}"
              alt="{{ frame | capitalize }} frame · {{ tile | capitalize }} tile"
              class="{% if combo == default_combo %}active{% endif %}"
              data-combo="{{ combo }}"
              loading="lazy">
          {%- endif -%}
        {%- endfor -%}
      </div>

      <!-- Right: Controls & form -->
      <div class="product-right">
        <h2>{{ section.settings.product_title | default: 'Bring Your Journey to Life' }}</h2>
        <p class="product-subtitle">{{ section.settings.product_subtitle | default: 'Your accomplishment, beautifully 3D-printed in stunning detail and professionally framed.' }}</p>

        <div class="product-price">
          ${{ base_price_int }} <span class="price-note">AUD · Delivery included</span>
        </div>

        <!-- Frame Colour -->
        <div class="frame-selector">
          <div class="frame-selector-title">Frame Colour</div>
          <div class="frame-btns">
            <button type="button" class="frame-btn active" data-frame="black">Black Frame</button>
            <button type="button" class="frame-btn"        data-frame="white">White Frame</button>
          </div>
        </div>

        <!-- Tile Colour -->
        <div class="frame-selector">
          <div class="frame-selector-title">Tile Colour</div>
          <div class="frame-btns">
            <button type="button" class="frame-btn active" data-tile="black">Black tile · White trail</button>
            <button type="button" class="frame-btn"        data-tile="white">White tile · Black trail</button>
          </div>
        </div>

        <!-- Toggle to expand the order form -->
        <button type="button" class="order-toggle" data-order-toggle aria-expanded="false" aria-controls="orderCollapse">
          <span data-order-toggle-label>Start Your Order</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
        </button>

        <!-- Collapsible wrapper -->
        <div class="order-collapse" id="orderCollapse">

        {% form 'product', product, id: 'orderForm', class: 'order-form', novalidate: 'novalidate', data-product-form: true %}
          <!-- Variant ID is set live by JS based on Frame×Tile selection -->
          <input type="hidden" name="id" data-variant-id value="{{ product.selected_or_first_available_variant.id }}">
          <input type="hidden" name="quantity" value="1">

          <!-- Snapshotted choices for the order email / admin view -->
          <input type="hidden" name="properties[Frame Colour]" data-prop-frame value="Black Frame">
          <input type="hidden" name="properties[Tile Colour]"  data-prop-tile  value="Black tile · White trail">
          <input type="hidden" name="properties[Add-On]"       data-prop-addon value="Frame only">
          <input type="hidden" name="properties[GPS File]"     data-prop-gps-file value="">
          <input type="hidden" name="properties[Route Source]" data-prop-route-source value="">

          <!-- GPS Route Data -->
          <div class="route-upload-section">
            <div class="route-upload-header">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span>Your Route Data</span>
            </div>
            <p class="route-upload-desc">Share your adventure with us using any of the options below. We'll use this to create your 3D map.</p>

            <div class="route-option-tabs">
              <button type="button" class="route-tab active" data-route-tab="link">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                Paste Link
              </button>
              <button type="button" class="route-tab" data-route-tab="file">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                Upload File
              </button>
              <button type="button" class="route-tab" data-route-tab="screenshot">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                Screenshot
              </button>
            </div>

            <div class="route-tab-content" data-route-tab-content="link">
              <div class="order-field">
                <label for="routeLink">Activity Link</label>
                <input type="url" id="routeLink" name="properties[Route Link]" placeholder="e.g. https://www.strava.com/activities/123456789">
                <span class="route-field-hint">Strava, AllTrails, Garmin, Komoot, or any activity URL</span>
              </div>
            </div>

            <div class="route-tab-content" data-route-tab-content="file" style="display:none;">
              <div class="order-field">
                <label for="routeFile">GPX / KML / FIT File</label>
                <div class="file-upload-zone" data-file-zone="file">
                  <input type="file" id="routeFile" accept=".gpx,.kml,.fit,.tcx" style="display:none;">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="rgba(196,149,106,0.5)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                  <span class="file-upload-text">Click to browse or drag &amp; drop</span>
                  <span class="file-upload-hint">GPX, KML, FIT, or TCX · max 25 MB</span>
                </div>
                <span class="file-name-display" data-file-display="file"></span>
              </div>
            </div>

            <div class="route-tab-content" data-route-tab-content="screenshot" style="display:none;">
              <div class="order-field">
                <label for="routeScreenshot">Screenshot of Your Route</label>
                <div class="file-upload-zone" data-file-zone="screenshot">
                  <input type="file" id="routeScreenshot" accept="image/*,.heic" style="display:none;">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="rgba(196,149,106,0.5)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                  <span class="file-upload-text">Click to browse or drag &amp; drop</span>
                  <span class="file-upload-hint">PNG, JPG, HEIC · max 25 MB</span>
                </div>
                <span class="file-name-display" data-file-display="screenshot"></span>
              </div>
            </div>
          </div>

          <div class="order-field">
            <label for="adventureTitle">Title of Adventure</label>
            <input type="text" id="adventureTitle" name="properties[Title of Adventure]" placeholder="e.g. Mt Kosciuszko Summit" required>
          </div>

          <div class="order-field">
            <label for="adventureSubtitle">Subtitle</label>
            <input type="text" id="adventureSubtitle" name="properties[Subtitle]" placeholder="e.g. The Roof of Australia">
          </div>

          <div class="order-field">
            <label for="fullName">Full Name</label>
            <input type="text" id="fullName" name="properties[Full Name]" placeholder="Name to be printed" required>
          </div>

          <div class="order-field-row">
            <div class="order-field">
              <label for="distance">Distance</label>
              <input type="text" id="distance" name="properties[Distance]" placeholder="e.g. 22.4 km">
            </div>
            <div class="order-field">
              <label for="elevation">Elevation</label>
              <input type="text" id="elevation" name="properties[Elevation]" placeholder="e.g. 1,280 m">
            </div>
          </div>

          <div class="order-field-row">
            <div class="order-field">
              <label for="location">Location</label>
              <input type="text" id="location" name="properties[Location]" placeholder="e.g. Kosciuszko NP, NSW">
            </div>
            <div class="order-field">
              <label for="eventDate">Date of Event</label>
              <input type="date" id="eventDate" name="properties[Date of Event]" required>
            </div>
          </div>

          <div class="order-field">
            <label for="timeCompleted">Time Completed</label>
            <input type="text" id="timeCompleted" name="properties[Time Completed]" placeholder="e.g. 5h 32m">
          </div>

          <div class="order-field">
            <label for="deliveryMethod">Delivery Method</label>
            <select id="deliveryMethod" name="properties[Delivery Method]" required>
              <option value="Delivery (included in price)">Delivery (included in price)</option>
              <option value="Collect in person (Melbourne)">Collect in person</option>
            </select>
            <span class="route-field-hint">Collection available from Port Melbourne or Knoxfield. We'll confirm pickup address and time when your order is ready.</span>
          </div>

          <!-- Optional Add-Ons -->
          {%- assign addons_enabled = false -%}
          {%- if section.settings.addon_wall_variant_id != blank
              and section.settings.addon_stand_variant_id != blank
              and section.settings.addon_both_variant_id != blank -%}
            {%- assign addons_enabled = true -%}
          {%- endif -%}

          <div class="frame-selector addon-selector" style="margin-top:0.5rem;">
            <div class="frame-selector-title">Optional Add-On</div>
            <div class="addon-grid">
              <button type="button" class="frame-btn addon-btn active" data-addon="none">
                <span class="addon-label">Frame only</span>
                <span class="addon-price">Included</span>
              </button>
              <button type="button" class="frame-btn addon-btn" data-addon="wall">
                <span class="addon-info" data-addon-info="{{ section.settings.wall_image | image_url: width: 1200 | default: 'product/wall-mount.jpg' }}" data-addon-alt="Wall mount system with 3M Command Strips" aria-label="View wall mount photo">i</span>
                <span class="addon-label">Wall mount system<br><span class="addon-sub">3M Command Strips</span></span>
                <span class="addon-price">+$15</span>
              </button>
              <button type="button" class="frame-btn addon-btn" data-addon="stand">
                <span class="addon-info" data-addon-info="{{ section.settings.stand_image | image_url: width: 1200 | default: 'product/desktop-stand.jpg' }}" data-addon-alt="Desktop stand" aria-label="View desktop stand photo">i</span>
                <span class="addon-label">Desktop stand</span>
                <span class="addon-price">+$10</span>
              </button>
              <button type="button" class="frame-btn addon-btn" data-addon="both">
                <span class="addon-info" data-addon-info="{{ section.settings.both_image | image_url: width: 1200 | default: 'product/wall-mount-and-stand.jpg' }}" data-addon-alt="Wall mount system + Desktop stand" aria-label="View wall mount and stand photo">i</span>
                <span class="addon-label">Wall mount system + Stand</span>
                <span class="addon-price">+$20</span>
              </button>
            </div>
            {%- unless addons_enabled -%}
              <p class="addon-note">Add-ons selected here are recorded with your order — we'll confirm pricing in your confirmation email.</p>
            {%- endunless -%}
          </div>

          <button type="submit" class="order-btn" data-order-submit>Order Now — ${{ base_price_int }} AUD</button>

          <p class="order-note">
            After placing your order, we'll send you a confirmation email. If we need any additional information or clarification about your adventure details, we'll reach out to you via email.
          </p>
        {% endform %}
        </div><!-- /.order-collapse -->

        <!-- Delivery info -->
        <div class="delivery-info">
          <div class="delivery-option">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            <div>
              <div class="delivery-option-title">Free Delivery</div>
              <div class="delivery-option-text">Australia-wide delivery included in price. Production typically takes 1–3 business days; allow up to 8 business days during peak periods (e.g. Black Friday, Christmas, Mother's / Father's Day). Standard shipping with Australia Post is 3–7 business days.</div>
            </div>
          </div>
          <div class="delivery-option">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <div>
              <div class="delivery-option-title">Prefer to collect?</div>
              <div class="delivery-option-text">Two Melbourne pickup points — Port Melbourne or Knoxfield. Select "Collect in person" above and we'll confirm pickup address and time when your print is ready.</div>
            </div>
          </div>
        </div>

        <!-- Accordion details -->
        <div class="product-accordion">
          <div class="product-accordion-item">
            <button type="button" class="product-accordion-header" data-accordion-toggle>
              Description
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="product-accordion-body">
              <div class="product-accordion-content">
                Each adventure map is created from your actual GPS data — imported from Strava, AllTrails, Garmin, or any GPX file. The terrain is 3D-printed with high-resolution elevation data, and your route is highlighted across the landscape. Professionally framed and ready to hang.
              </div>
            </div>
          </div>
          <div class="product-accordion-item">
            <button type="button" class="product-accordion-header" data-accordion-toggle>
              What's Included
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="product-accordion-body">
              <div class="product-accordion-content">
                • 3D-printed topographic adventure map<br>
                • Custom title, subtitle &amp; adventure stats<br>
                • Professional frame (black or white)<br>
                • Ready to hang hardware<br>
                • Australia-wide delivery
              </div>
            </div>
          </div>
          <div class="product-accordion-item">
            <button type="button" class="product-accordion-header" data-accordion-toggle>
              Dimensions &amp; Specs
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="product-accordion-body">
              <div class="product-accordion-content">
                Details coming soon — check back or contact us at <a href="mailto:hello@peakframed.com.au" style="color:var(--color-accent);">hello@peakframed.com.au</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Variant + Cloudinary config exposed to JS -->
    <script type="application/json" data-pf-config>
    {
      "variants": {
        {%- for v in product.variants -%}
          {%- assign frame = v.option1 | downcase -%}
          {%- assign tile  = v.option2 | downcase -%}
          "{{ frame }}-{{ tile }}": {{ v.id }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      },
      "basePrice": {{ base_price_int }},
      "addons": {
        "enabled": {{ addons_enabled }},
        "wall":  { "label": "Wall mount system (3M Command Strips)", "extra": 15, "variantId": {{ section.settings.addon_wall_variant_id | default: 0 }} },
        "stand": { "label": "Desktop stand",                          "extra": 10, "variantId": {{ section.settings.addon_stand_variant_id | default: 0 }} },
        "both":  { "label": "Wall mount system + Desktop stand",      "extra": 20, "variantId": {{ section.settings.addon_both_variant_id | default: 0 }} }
      },
      "cloudinary": {
        "cloudName":    {{ settings.cloudinary_cloud_name | json }},
        "uploadPreset": {{ settings.cloudinary_upload_preset | json }},
        "maxBytes":     {{ settings.cloudinary_max_mb | times: 1048576 }},
        "allowedExt":   ["gpx","kml","fit","tcx","jpg","jpeg","png","heic"]
      }
    }
    </script>

    {%- endif -%}{%- comment -%} /product != blank {%- endcomment -%}
  </div>
</section>

{% schema %}
{
  "name": "Product order",
  "settings": [
    {
      "type": "header",
      "content": "Section copy"
    },
    { "type": "text", "id": "label",          "label": "Eyebrow label",    "default": "Order Yours" },
    { "type": "text", "id": "headline",       "label": "Headline",         "default": "Get Your Adventure Printed" },
    { "type": "text", "id": "product_title",  "label": "Product card title", "default": "Bring Your Journey to Life" },
    { "type": "text", "id": "product_subtitle", "label": "Product subtitle", "default": "Your accomplishment, beautifully 3D-printed in stunning detail and professionally framed." },

    { "type": "header", "content": "Product binding" },
    { "type": "text", "id": "product_handle", "label": "Product handle", "default": "adventure-map", "info": "Handle of the Shopify product to sell. Must have option1 = Frame Colour and option2 = Tile Colour with values Black / White." },

    { "type": "header", "content": "Add-on photos (info icons open these in lightbox)" },
    { "type": "image_picker", "id": "wall_image",  "label": "Wall mount photo" },
    { "type": "image_picker", "id": "stand_image", "label": "Desktop stand photo" },
    { "type": "image_picker", "id": "both_image",  "label": "Wall mount + stand photo" },

    { "type": "header", "content": "Add-on charging (optional)" },
    {
      "type": "paragraph",
      "content": "To charge for add-ons, create an \"Optional Add-Ons\" product with 3 variants (Wall Mount +$15, Desktop Stand +$10, Both +$20) and paste each variant ID below. Until all three are filled, add-on choices are recorded with the order but not charged at checkout."
    },
    { "type": "text", "id": "addon_wall_variant_id",  "label": "Wall mount variant ID" },
    { "type": "text", "id": "addon_stand_variant_id", "label": "Desktop stand variant ID" },
    { "type": "text", "id": "addon_both_variant_id",  "label": "Both add-ons variant ID" }
  ],
  "presets": [{ "name": "Product order" }]
}
{% endschema %}
